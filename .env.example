# PostgreSQL multi-tenant (opt-in durante a migração das Sheets)
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=ai-video-creator

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=1qI4NrKAXV8Tcf2LsmG3-UpoFpSuzbi-cQ0A5o3CSPJQ
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1qI4NrKAXV8Tcf2LsmG3-UpoFpSuzbi-cQ0A5o3CSPJQ/edit
GOOGLE_SHEETS_GID=1596729829

# Use one of these approaches when enabling Google Sheets API:
# 1) Service account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=

# 2) Or paste JSON credentials into a secret manager / CI variable, not into git.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 3) OAuth Desktop App client secrets. Use this when service account key creation is disabled.
GOOGLE_OAUTH_CLIENT_SECRETS=
GOOGLE_OAUTH_TOKEN_FILE=.google_sheets_token.json

# Video generation
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=
DASHBOARD_LIVE_HEYGEN=1

# Geracao do pack de conteudo
ANTHROPIC_API_KEY=
# Modelo economico para analises e ideias. Haiku 4.5 reduz custo e latencia.
# Para uma tarefa premium, troque temporariamente por um modelo Sonnet disponivel.
ANTHROPIC_MODEL=claude-haiku-4-5
# Direção multicâmera e Cinematic: selecione um Sonnet habilitado na sua conta.
# Se o modelo principal for removido, a direção tenta o fallback e depois outro Sonnet visível para a credencial.
ANTHROPIC_SCENE_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_SCENE_SONNET_FALLBACK_MODEL=
# Para usar um Sonnet específico somente no Cinematic, defina este campo; vazio reutiliza o modelo acima.
ANTHROPIC_CINEMATIC_MODEL=
# Story Mode: configure explicitamente um modelo premium disponível na conta.
# O reparo faz no máximo uma tentativa e reutiliza o modelo premium quando vazio.
ANTHROPIC_STORY_MODEL=
ANTHROPIC_STORY_REPAIR_MODEL=
# Reservados para os próximos slices de crítica e revisão visual.
ANTHROPIC_STORY_CRITIC_MODEL=
ANTHROPIC_STORY_QC_MODEL=
# Estimativas operacionais do Story Mode. Mantenha alinhadas ao contrato da conta.
HEYGEN_VIDEO_AGENT_ESTIMATED_JOB_USD=
HEYGEN_DIRECT_VIDEO_ESTIMATED_JOB_USD=

# Publishing / scheduling
SOCIALPILOT_API_KEY=

# Instagram / Meta Graph API
# Token de uma conta profissional com permissao de publicacao de conteudo.
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Permite atualizar a versao sem alterar o codigo quando a Meta descontinuar uma versao.
META_GRAPH_API_VERSION=v23.0
