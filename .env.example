# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=1qI4NrKAXV8Tcf2LsmG3-UpoFpSuzbi-cQ0A5o3CSPJQ
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1qI4NrKAXV8Tcf2LsmG3-UpoFpSuzbi-cQ0A5o3CSPJQ/edit
GOOGLE_SHEETS_GID=1596729829

# Use one of these approaches when enabling Google Sheets API:
# 1) Service account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=

# 2) Or paste JSON credentials into a secret manager / CI variable, not into git.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# 3) OAuth Desktop App client secrets. Use this when service account key creation is disabled.
GOOGLE_OAUTH_CLIENT_SECRETS=
GOOGLE_OAUTH_TOKEN_FILE=.google_sheets_token.json

# Video generation
HEYGEN_API_KEY=
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=
DASHBOARD_LIVE_HEYGEN=1

# Geracao do pack de conteudo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Publishing / scheduling
SOCIALPILOT_API_KEY=

# Instagram / Meta Graph API
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
