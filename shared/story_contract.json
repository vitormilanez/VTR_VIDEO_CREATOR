{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-video-creator/story-contract-v1.json",
  "title": "AI Video Creator Story Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "storyBible",
    "characterBible",
    "visualBible",
    "medicalAssertions",
    "shots"
  ],
  "properties": {
    "contractVersion": {
      "const": "story-contract-v1"
    },
    "storyBible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["premise", "educationalGoal", "narrativeArc", "historicalSetting"],
      "properties": {
        "premise": { "type": "string", "minLength": 10, "maxLength": 500 },
        "educationalGoal": { "type": "string", "minLength": 10, "maxLength": 500 },
        "narrativeArc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["opening", "development", "turn", "ending"],
          "properties": {
            "opening": { "type": "string", "minLength": 3, "maxLength": 240 },
            "development": { "type": "string", "minLength": 3, "maxLength": 240 },
            "turn": { "type": "string", "minLength": 3, "maxLength": 240 },
            "ending": { "type": "string", "minLength": 3, "maxLength": 240 }
          }
        },
        "historicalSetting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["period", "location", "accuracyMode"],
          "properties": {
            "period": { "type": "string", "maxLength": 160 },
            "location": { "type": "string", "maxLength": 200 },
            "accuracyMode": {
              "type": "string",
              "enum": ["strict", "inspired", "not_applicable"]
            }
          }
        }
      }
    },
    "characterBible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterId",
        "lookId",
        "identityRule",
        "voiceRule",
        "wardrobe",
        "forbiddenChanges"
      ],
      "properties": {
        "characterId": { "type": ["string", "null"], "maxLength": 160 },
        "lookId": { "type": ["string", "null"], "maxLength": 160 },
        "identityRule": { "type": "string", "minLength": 3, "maxLength": 300 },
        "voiceRule": { "type": "string", "minLength": 3, "maxLength": 300 },
        "wardrobe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "accessories", "colors"],
          "properties": {
            "base": { "type": "string", "maxLength": 240 },
            "accessories": {
              "type": "array",
              "maxItems": 8,
              "items": { "type": "string", "minLength": 1, "maxLength": 100 }
            },
            "colors": {
              "type": "array",
              "maxItems": 8,
              "items": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        },
        "forbiddenChanges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 3, "maxLength": 180 }
        }
      }
    },
    "visualBible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "lighting",
        "cameraStyle",
        "texture",
        "forbiddenAnachronisms"
      ],
      "properties": {
        "palette": { "type": "string", "minLength": 3, "maxLength": 240 },
        "lighting": { "type": "string", "minLength": 3, "maxLength": 240 },
        "cameraStyle": { "type": "string", "minLength": 3, "maxLength": 240 },
        "texture": { "type": "string", "minLength": 3, "maxLength": 240 },
        "forbiddenAnachronisms": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "medicalAssertions": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string" }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "narrativePurpose",
          "shotType",
          "providerStrategy",
          "durationSeconds",
          "speech",
          "character",
          "environment",
          "action",
          "camera",
          "lighting",
          "continuityKeys",
          "referenceAssetIds",
          "negativePrompt",
          "audioPolicy",
          "estimatedCost"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^shot-[0-9]{2}$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 12 },
          "narrativePurpose": { "type": "string", "minLength": 3, "maxLength": 300 },
          "shotType": {
            "type": "string",
            "enum": ["avatar_anchor", "historical_broll", "modern_broll", "transition", "local_asset"]
          },
          "providerStrategy": {
            "type": "string",
            "enum": ["video_agent", "direct_video", "local_compositor"]
          },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
          "speech": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "startWordIndex", "endWordIndex"],
            "properties": {
              "mode": {
                "type": "string",
                "enum": ["avatar_speaks", "voice_continues_from_base_scene"]
              },
              "startWordIndex": { "type": "integer", "minimum": 0 },
              "endWordIndex": { "type": "integer", "minimum": 1 }
            }
          },
          "character": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "characterId", "lookId"],
            "properties": {
              "required": { "type": "boolean" },
              "characterId": { "type": ["string", "null"], "maxLength": 160 },
              "lookId": { "type": ["string", "null"], "maxLength": 160 }
            }
          },
          "environment": { "type": "string", "minLength": 3, "maxLength": 500 },
          "action": { "type": "string", "minLength": 3, "maxLength": 500 },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": ["framing", "movement", "lens"],
            "properties": {
              "framing": { "type": "string", "minLength": 2, "maxLength": 160 },
              "movement": { "type": "string", "minLength": 2, "maxLength": 160 },
              "lens": { "type": "string", "minLength": 2, "maxLength": 160 }
            }
          },
          "lighting": { "type": "string", "minLength": 2, "maxLength": 200 },
          "continuityKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 2, "maxLength": 100 }
          },
          "referenceAssetIds": {
            "type": "array",
            "maxItems": 12,
            "items": { "type": "string", "minLength": 1, "maxLength": 160 }
          },
          "negativePrompt": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 140 }
          },
          "audioPolicy": {
            "type": "string",
            "enum": ["preserve_base_narration", "mute_generated_audio"]
          },
          "estimatedCost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heygenJobs", "anthropicCalls"],
            "properties": {
              "heygenJobs": { "type": "integer", "minimum": 0, "maximum": 1 },
              "anthropicCalls": { "type": "integer", "const": 0 }
            }
          }
        }
      }
    }
  }
}
